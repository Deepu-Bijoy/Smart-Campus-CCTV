PROJECT_NAME="AI-Powered Smart CCTV Investigation System"
API_V1_STR="/api/v1"
SECRET_KEY="SUPER_SECRET_REPLACE_THIS_IN_PRODUCTION"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM="HS256"

# Postgres
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="securepassword"
POSTGRES_DB="cctv_investigation"

# Vector DB
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_API_KEY=""

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379

# Storage
STORAGE_DIR="storage"
# Configurable video upload limit in bytes (5 GiB = 5368709120)
MAX_UPLOAD_SIZE_BYTES=5368709120

# Logging
LOG_LEVEL="INFO"

# Local Fallback Flags (run without Docker)
# For local dev / standalone test runs without background worker daemons:
# - DB_FALLBACK_SQLITE=true (uses SQLite instead of PostgreSQL)
# - QDRANT_IN_MEMORY=true (uses local disk/memory Qdrant)
# - CELERY_ALWAYS_EAGER=true (executes Celery tasks synchronously in caller thread)
#
# For production worker deployment with Redis broker:
# - Set DB_FALLBACK_SQLITE=false
# - Set QDRANT_IN_MEMORY=false
# - Set CELERY_ALWAYS_EAGER=false
# - Run worker: celery -A app.tasks.cel_app worker -Q gpu_queue,cpu_queue --loglevel=info
DB_FALLBACK_SQLITE=true
QDRANT_IN_MEMORY=true
CELERY_ALWAYS_EAGER=true
