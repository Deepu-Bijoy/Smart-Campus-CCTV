PROJECT_NAME="AI-Powered Smart CCTV Investigation System"
API_V1_STR="/api/v1"
SECRET_KEY="SUPER_SECRET_REPLACE_THIS_IN_PRODUCTION"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM="HS256"

# Postgres
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="securepassword"
POSTGRES_DB="cctv_investigation"

# Vector DB
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_API_KEY=""

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379

# Storage
STORAGE_DIR="storage"

# Logging
LOG_LEVEL="INFO"

# Local Fallback Flags (run without Docker)
# If true, runs SQLite instead of PostgreSQL, in-memory Qdrant instead of remote,
# and synchronous Celery execution (no background Redis needed).
DB_FALLBACK_SQLITE=true
QDRANT_IN_MEMORY=true
CELERY_ALWAYS_EAGER=true
